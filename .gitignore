# ============================================
# Nexus ERP - Comprehensive Git Ignore
# Prevents ALL unwanted files from deployment
# ============================================

# Dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# Env files (can opt-in for committing if needed)
.env*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
local-*

# AI/Config files
.claude
.z-ai-config
test
prompt

# ============================================
# CRITICAL: Block unwanted directories/files
# These were causing deployment failures!
# ============================================

# Skills directory (auto-generated, not needed)
skills/
skills/**/*

# Tool results (temporary debug files)
tool-results/
tool-results/**/*

# Uploads (user images - not for repo)
upload/
upload/**/*

# Research files (large JSON)
research_inventory_*.json
research/

# Images (unless in public/)
*.jpg
*.png
*.gif
*.jpeg
!public/*.jpg
!public/*.png
!public/**/*.jpg
!public/**/*.png

# Backup files
*.bak
*.swp
*~
